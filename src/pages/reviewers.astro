---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Reviewers · Sutton Hills Research Partners">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .reviewer-card { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.5rem; margin-bottom:1rem; }
  .reviewer-card h3 { font-family:var(--font-heading); color:var(--color-primary); }
  .reviewer-card p { color:var(--color-muted); font-size:0.95rem; margin-top:0.25rem; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Named Reviewers</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Our external peer-review board ensures report quality and independence.</p>
  </div>
  <p style="max-width:700px; color:var(--color-muted); line-height:1.8;">All substantive reports undergo review by at least one named external reviewer. The following individuals serve on our advisory panel:</p>
  <div class="reviewer-card">
    <h3>Dr. Eleanor Hartwell</h3>
    <p>Former Director of Standards, Financial Conduct Authority · Specialises in regulatory frameworks and compliance technology</p>
  </div>
  <div class="reviewer-card">
    <h3>Marcus Chen</h3>
    <p>Principal Analyst (independent) · 20+ years in enterprise software procurement and vendor evaluation</p>
  </div>
  <div class="reviewer-card">
    <h3>Prof. Sarah Okonkwo</h3>
    <p>Department of Computer Science, University of Cambridge · Research focus on AI governance and algorithmic transparency</p>
  </div>
</div>
</BaseLayout>
