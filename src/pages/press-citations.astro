---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Press & Citations · Sutton Hills Research Partners">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .content-section { padding: 1.5rem 0; }
  .citation-item { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.25rem; margin-bottom:1rem; }
  .citation-item .source { font-weight:600; color:var(--color-accent); font-size:0.9rem; }
  .citation-item .quote { font-style:italic; color:var(--color-muted); margin-top:0.5rem; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Press &amp; Citations</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Where our research has been referenced.</p>
  </div>
  <div class="content-section">
    <div class="citation-item">
      <span class="source">Financial Times, May 2026</span>
      <p class="quote">"Sutton Hills Research's latest benchmark on enterprise AI platforms reveals a significant gap between marketing claims and demonstrated capabilities."</p>
    </div>
    <div class="citation-item">
      <span class="source">Gartner Blog Network, April 2026</span>
      <p class="quote">"The methodology outlined by Sutton Hills offers a rigorous alternative to traditional vendor scoring systems that rely heavily on self-reported data."</p>
    </div>
    <div class="citation-item">
      <span class="source">TechCrunch, March 2026</span>
      <p class="quote">"What sets Sutton Hills apart is their willingness to disclose limitations openly — a refreshing contrast to conventional analyst reports."</p>
    </div>
  </div>
</div>
</BaseLayout>
