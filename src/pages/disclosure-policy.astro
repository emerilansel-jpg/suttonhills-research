---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Disclosure Policy · Sutton Hills Research Partners">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .content-section { padding: 1.5rem 0; }
  .content-section p { max-width:700px; line-height:1.8; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Disclosure Policy</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Transparency is central to our work.</p>
  </div>
  <div class="content-section">
    <p>Every report includes a disclosure statement covering:</p>
    <ul style="padding-left:1.5rem; margin:1rem 0;">
      <li style="margin-bottom:0.5rem;">Commercial relationships with any organisation mentioned</li>
      <li style="margin-bottom:0.5rem;">Source of funding for the research project</li>
      <li style="margin-bottom:0.5rem;">Potential conflicts of interest of authors and reviewers</li>
    </ul>
    <p>If new information emerges about undisclosed relationships after publication, we will issue a correction notice within 48 hours.</p>
  </div>
</div>
</BaseLayout>
