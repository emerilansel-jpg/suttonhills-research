---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About · Sutton Hills Research Partners">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .content-section { padding: 1.5rem 0; }
  .content-section p { max-width:700px; line-height:1.8; }
  .values-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:1.5rem; margin-top:1.5rem; }
  .value-card { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.5rem; }
  .value-card h4 { font-family:var(--font-heading); color:var(--color-primary); margin-bottom:0.5rem; }
</style>

<div class="container">
  <div class="page-header">
    <h1>About Us</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Who we are and why our research matters.</p>
  </div>

  <div class="content-section">
    <p>Sutton Hills Research Partners is an independent research organisation founded on the principle that procurement decisions should be guided by evidence, not vendor marketing.</p>
    <p>Our analysts and reviewers come from backgrounds spanning financial services, technology, healthcare, and government — bringing decades of real-world experience to bear on every report we publish.</p>
  </div>

  <div class="content-section">
    <h2 style="font-size:1.5rem;">Our Principles</h2>
    <div class="values-grid">
      <div class="value-card">
        <h4>Evidence First</h4>
        <p style="font-size:0.95rem;color:var(--color-muted);">Every claim in our reports must be substantiated by verifiable data or documented expert testimony.</p>
      </div>
      <div class="value-card">
        <h4>No Pay-to-Rank</h4>
        <p style="font-size:0.95rem;color:var(--color-muted);">We accept no payment, sponsorship, or compensation that could influence our evaluations or rankings.</p>
      </div>
      <div class="value-card">
        <h4>Open Corrections</h4>
        <p style="font-size:0.95rem;color:var(--color-muted);">When errors occur, we correct them publicly. Our correction history is transparent and accessible.</p>
      </div>
      <div class="value-card">
        <h4>Peer Review</h4>
        <p style="font-size:0.95rem;color:var(--color-muted);">All substantive reports are reviewed by at least one named external reviewer before publication.</p>
      </div>
    </div>
  </div>
</div>
</BaseLayout>
