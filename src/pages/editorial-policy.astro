---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Editorial Policy · Sutton Hills Research Partners">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .content-section { padding: 1.5rem 0; }
  .content-section p { max-width:700px; line-height:1.8; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Editorial Policy</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">How we ensure independence and accuracy.</p>
  </div>
  <div class="content-section">
    <p>All editorial decisions are made by our research team without commercial input. We do not accept payment for favourable coverage, endorsements, or placement. Vendor organisations may respond to drafts before publication but have no influence on content.</p>
    <p style="margin-top:1rem;">Our analysts sign annual conflict-of-interest declarations. Any potential conflicts are disclosed alongside affected reports.</p>
  </div>
</div>
</BaseLayout>
