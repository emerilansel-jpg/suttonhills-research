---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Team · Sutton Hills Research Partners">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .team-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem; }
  .team-card { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.5rem; text-align:center; }
  .team-card h4 { font-family:var(--font-heading); color:var(--color-primary); font-size:1.15rem; }
  .team-card p { color:var(--color-muted); font-size:0.9rem; margin-top:0.25rem; line-height:1.6; }
  .team-card .role { font-weight:600; color:var(--color-accent); font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Our Team</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Analysts and reviewers bringing institutional-grade expertise.</p>
  </div>
  <div class="team-grid">
    <div class="team-card">
      <div class="role">Founder &amp; Chief Analyst</div>
      <h4>James Whitmore</h4>
      <p>Former Gartner analyst with 18 years in technology and financial services research. Specialises in market mapping and comparative vendor evaluation.</p>
    </div>
    <div class="team-card">
      <div class="role">Senior Researcher</div>
      <h4>Rachel Tanaka</h4>
      <p>PhD in Data Science, Oxford. Led data analysis for three Fortune 500 procurement transformations. Focuses on quantitative benchmarking methodology.</p>
    </div>
    <div class="team-card">
      <div class="role">Policy &amp; Compliance Lead</div>
      <h4>David Adeyemi</h4>
      <p>15 years in regulatory affairs across EU and UK markets. Ensures all reports meet highest editorial and compliance standards.</p>
    </div>
  </div>
</div>
</BaseLayout>
