---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found · Sutton Hills Research Partners">
<style>
  .not-found { text-align:center; padding:6rem 0; }
  .not-found h1 { font-size:6rem; color:var(--color-accent); margin-bottom:0.5rem; }
  .not-found p { color:var(--color-muted); font-size:1.2rem; }
  .not-found a { font-weight:600; }
</style>

<div class="container">
  <div class="not-found">
    <h1>404</h1>
    <p>This page doesn't exist or has been removed.</p>
    <a href="/" class="btn" style="margin-top:1.5rem;">Return Home</a>
  </div>
</div>
</BaseLayout>
