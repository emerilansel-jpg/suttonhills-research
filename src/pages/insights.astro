---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Insights · Sutton Hills Research Partners">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .section { padding: 2rem 0; }
  .highlight-box { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:2rem; margin:1.5rem 0; }
  .highlight-box h3 { font-family:var(--font-heading); color:var(--color-primary); margin-bottom:0.5rem; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Insights & Analysis</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Commentary, sector briefings, and emerging trend analysis from our research desk.</p>
  </div>

  <div class="section">
    <div class="highlight-box">
      <h3>Sector Briefing: AI Governance Frameworks Q2 2026</h3>
      <p style="color:var(--color-muted); margin:0.75rem 0;">As regulatory frameworks for generative AI mature across jurisdictions, we examine which standards are gaining traction in enterprise procurement decisions.</p>
      <a href="/research" style="font-weight:600;">View full briefing →</a>
    </div>
  </div>
</div>
</BaseLayout>
